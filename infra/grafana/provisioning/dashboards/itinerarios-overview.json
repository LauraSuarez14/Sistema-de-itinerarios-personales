{
  "title": "Sistema de Itinerarios — Overview",
  "uid": "itinerarios-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Circuit Breaker — API Colombia (0=closed,1=open,2=half_open)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "airport_circuit_breaker_state{target=\"api-colombia\"}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Cache Redis — hits vs misses (5m rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "expr": "sum(rate(airport_cache_hits_total[5m])) by (operation)", "legendFormat": "hits:{{operation}}", "refId": "A" },
        { "expr": "sum(rate(airport_cache_misses_total[5m])) by (operation)", "legendFormat": "misses:{{operation}}", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "title": "RabbitMQ — mensajes listos por cola",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "rabbitmq_queue_messages_ready", "legendFormat": "{{queue}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "RabbitMQ — dead-letter queue",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
      "targets": [
        { "expr": "rabbitmq_queue_messages{queue=\"itinerary.notifications.dead\"}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "HTTP requests por servicio (rate 5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum(rate(http_requests_total[5m])) by (job)", "legendFormat": "{{job}}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Bulkhead rejections (5m increase)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "increase(airport_bulkhead_rejections_total[5m])", "legendFormat": "{{target}}", "refId": "A" }
      ]
    }
  ]
}
