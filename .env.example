# Copiar a .env y ajustar si es necesario. docker-compose.yml lee estas variables.

# --- General ---
JWT_SECRET_KEY=dev-secret-change-me
LOG_LEVEL=INFO

# --- Airport Service ---
API_COLOMBIA_BASE_URL=https://api-colombia.com/api/v1
# Cuando TOXIPROXY_ENABLED=true, Airport Service llama a la API externa a
# través del proxy de Toxiproxy para poder inyectar fallos controlados.
TOXIPROXY_ENABLED=false
TOXIPROXY_PROXY_URL=http://toxiproxy:8666
REDIS_URL=redis://redis:6379/0
AIRPORT_CACHE_TTL_SECONDS=3600
AIRPORT_HTTP_PORT=8001
AIRPORT_GRPC_PORT=50051
OAUTH2_CLIENT_ID=itinerary-service
OAUTH2_CLIENT_SECRET=dev-client-secret-change-me

# --- Itinerary Service ---
ITINERARY_DB_HOST=itinerary-db
ITINERARY_DB_PORT=5432
ITINERARY_DB_NAME=itinerary
ITINERARY_DB_USER=itinerary
ITINERARY_DB_PASSWORD=itinerary-db-pass
AIRPORT_SERVICE_GRPC_URL=airport-service:50051
AIRPORT_SERVICE_HTTP_URL=http://airport-service:8001
OUTBOX_RELAY_INTERVAL_SECONDS=2
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=itinerary.events
ITINERARY_HTTP_PORT=8002

# --- API Gateway ---
GATEWAY_HTTP_PORT=8000
AIRPORT_SERVICE_URL=http://airport-service:8001
ITINERARY_SERVICE_URL=http://itinerary-service:8002
RATE_LIMIT_PER_MINUTE=60
DEMO_USER=viajero
DEMO_PASSWORD=viajero123

# --- Notification bridge / funciones serverless ---
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
SEND_NOTIFICATION_FUNCTION_NAME=SendNotificationFunction
GENERATE_REPORT_FUNCTION_NAME=GenerateItineraryReportFunction
NOTIFICATION_QUEUE=itinerary.notifications

# --- Vault ---
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-only-token

# --- Observabilidad ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
